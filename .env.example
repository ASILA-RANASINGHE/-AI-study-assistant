# Copy this file to .env and fill in your key.  .env is git-ignored.
# cp .env.example .env        (macOS/Linux)
# copy .env.example .env      (Windows)

# --- Required -------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Model ----------------------------------------------------------------
# Claude model used for answers, quizzes and flashcards.
# Valid ids include: claude-sonnet-5, claude-opus-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5
MAX_TOKENS=4096

# --- Retrieval / chunking -------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# How many previous user/assistant pairs are replayed for follow-up questions.
HISTORY_TURNS=4

# --- Storage --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=studymate_notes

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
